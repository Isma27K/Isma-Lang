# Sieve of Eratosthenes over a List[Bool].
fn sieve(limit: Int) -> List[Int]:
    var is_prime: List[Bool] = []
    for i in 0..=limit:
        is_prime.push(true)
    is_prime[0] = false
    is_prime[1] = false

    var i = 2
    while i * i <= limit:
        if is_prime[i]:
            var j = i * i
            while j <= limit:
                is_prime[j] = false
                j += i
        i += 1

    var primes: List[Int] = []
    for n in 0..=limit:
        if is_prime[n]:
            primes.push(n)
    return primes

fn main():
    val primes = sieve(100)
    print(f"{primes.len()} primes below 100, the largest is {primes[primes.len() - 1]}")
    var line = ""
    for p in primes:
        line += f"{p} "
    print(line)
    print(f"primes up to 1,000,000: {sieve(1_000_000).len()}")

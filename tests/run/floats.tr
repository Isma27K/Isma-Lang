fn main():
    print(0.1 + 0.2)
    print(3.0)
    print(-2.5)
    print(1.0 / 3.0)
    print(1e16)
    print(123456789.125)
    print(0.0001)
    print(0.00001)
    print(2.0 * 1e20)
    print(7.9.to_int())
    print((-7.9).to_int())
    print(7.to_float() / 2.0)
    print(sqrt(2.0))
    print(10.5 % 3.0)
    print(1e300 * 1e300)
    print(f"{1.5} {100.0} {-0.0}")

# Points and shapes: a module of the `modules` test program.

struct Point:
    x: Float
    y: Float

    fn dist(self, other: Point) -> Float:
        val dx = self.x - other.x
        val dy = self.y - other.y
        return sqrt(dx * dx + dy * dy)

enum Shape:
    Circle(center: Point, radius: Float)
    Rect(corner: Point, w: Float, h: Float)
    Empty

    fn area(self) -> Float:
        match self:
            case Circle(_, r):
                return _pi() * r * r
            case Rect(_, w, h):
                return w * h
            case Empty:
                return 0.0

    fn name(self) -> String:
        match self:
            case Circle:
                return "circle"
            case Rect:
                return "rect"
            case Empty:
                return "empty"

fn origin() -> Point:
    return Point(0.0, 0.0)

# Private: only this module can call it.
fn _pi() -> Float:
    return 3.14159

# Only runs when this file is the program itself.
fn main():
    print(origin().dist(Point(1.0, 1.0)))

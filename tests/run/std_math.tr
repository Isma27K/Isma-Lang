import math
from math import pi, max as biggest

fn main():
    print(math.pi)
    print(pi * 2.0 == math.tau)
    print(math.e)
    print(f"{math.inf} {-math.inf} {math.nan}")
    print(math.is_nan(math.nan))
    print(math.nan == math.nan)
    print(f"{math.max_int} {math.min_int}")
    print(math.sqrt(2.0))
    print(math.sqrt(16.0))
    print(math.cbrt(-8.0))
    print(math.pow(2.0, 10.0))
    print(math.exp(0.0))
    print(math.ln(math.e))
    print(math.log(8.0, 2.0))
    print(math.log2(1024.0))
    print(math.log10(1000.0))
    print(math.hypot(3.0, 4.0))
    print(f"{math.floor(2.7)} {math.floor(-2.5)} {math.ceil(2.1)} {math.ceil(-2.1)}")
    print(f"{math.round(2.5)} {math.round(-2.5)} {math.round(2.4)} {math.trunc(-2.7)}")
    print(math.round(3.7).to_int())
    print(math.sin(math.pi / 2.0))
    print(math.cos(0.0))
    print(math.atan2(1.0, 1.0) * 4.0)
    print(math.degrees(math.pi))
    print(math.radians(180.0))
    print(math.tanh(0.0))
    print(f"{math.max(3, 7)} {math.min(3, 7)} {biggest(2.5, -1.0)} {math.max("pear", "apple")}")
    print(f"{math.clamp(15, 0, 10)} {math.clamp(-5, 0, 10)} {math.clamp(0.5, 0.0, 1.0)}")
    print(f"{math.abs(-5)} {math.abs(5)} {math.abs(-2.5)}")
    print(f"{math.sign(-3.0)} {math.sign(0.0)} {math.sign(2.0)}")
    print(f"{math.is_inf(math.inf)} {math.is_finite(1.0)} {math.is_finite(math.nan)}")
    print(f"{math.gcd(12, 18)} {math.gcd(-12, 18)} {math.gcd(0, 0)} {math.lcm(4, 6)} {math.lcm(0, 3)}")
    print(f"{math.pow_int(3, 4)} {math.pow_int(2, 62)} {math.pow_int(-2, 3)} {math.pow_int(7, 0)}")
    print(f"{math.isqrt(0)} {math.isqrt(99)} {math.isqrt(100)} {math.isqrt(9223372036854775807)}")
    print(f"{math.factorial(0)} {math.factorial(20)}")

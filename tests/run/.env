# The default `.env` of the programs in this folder: env_dotenv.tr reads it.
TARN_DOTENV_PORT=8080
TARN_DOTENV_QUOTED="two words"   # a comment
export TARN_DOTENV_SINGLE='${not expanded}'
TARN_DOTENV_EXPANDED=${TARN_DOTENV_PORT}/x
TARN_DOTENV_MULTI="one
two"
TARN_DOTENV_DEBUG=Yes
TARN_DOTENV_BLANK=

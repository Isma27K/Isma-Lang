fn gcd(a: Int, b: Int) -> Int:
    if b == 0:
        return a
    return gcd(b, a % b)

fn main():
    print(7 / 2)
    print(-7 / 2)
    print(7 % 3)
    print(-7 % 3)
    print(2 + 3 * 4 - 1)
    print((2 + 3) * 4)
    print(-(5 - 8))
    print(gcd(1071, 462))
    print(1_000_000 * 1_000)
    print(0xff + 0b101)
    print(9223372036854775807)
    print(-9223372036854775808)
    var x = 10
    x -= 3
    x *= 2
    x /= 4
    x %= 2
    print(x)

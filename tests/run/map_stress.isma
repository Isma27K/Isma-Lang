# Random inserts, updates, lookups and removals, checked against a plain list
# of entries (in insertion order), for Int, String and struct keys. Exercises
# removed entries, rebuilds and the lookup hint of the hash table.
struct Key:
    a: Int
    b: String

    fn ==(self, other: Key) -> Bool:
        return self.a == other.a and self.b == other.b

    fn hash(self) -> Int:
        return hash(self.a % 3, self.b)       # deliberately weak: many collisions

struct Rng:
    var x: Int

    fn next(self, n: Int) -> Int:
        self.x = (self.x * 1103515245 + 12345) % 2147483648
        return self.x / 65536 % n

fn find(keys: List[Int], k: Int) -> Int:
    for i, x in keys:
        if x == k:
            return i
    return -1

fn check_ints(rng: Rng, ops: Int, space: Int) -> Int:
    val m: Map[Int, Int] = {}
    val keys: List[Int] = []
    val vals: List[Int] = []
    var errors = 0
    for step in 0..ops:
        val k = rng.next(space)
        val i = find(keys, k)
        match rng.next(5):
            case 0 | 1:
                m[k] = step
                if i < 0:
                    keys.push(k)
                    vals.push(step)
                else:
                    vals[i] = step
            case 2:
                val got = m.remove(k)
                if i < 0:
                    if got != null:
                        errors += 1
                else:
                    if got != vals[i]:
                        errors += 1
                    keys.remove_at(i)
                    vals.remove_at(i)
            case 3:
                if (k in m) != (i >= 0):
                    errors += 1
                if i >= 0:
                    m[k] += 1
                    vals[i] += 1
            case _:
                val want: Int? = if_found(vals, i)
                if m.get(k) != want:
                    errors += 1
        if m.len() != keys.len():
            errors += 1
    # Iteration follows insertion order.
    var j = 0
    for k, v in m:
        if k != keys[j] or v != vals[j]:
            errors += 1
        j += 1
    return errors

fn if_found(vals: List[Int], i: Int) -> Int?:
    if i < 0:
        return null
    return vals[i]

fn check_strings(rng: Rng, ops: Int) -> Int:
    val m: Map[String, Int] = {}
    val keys: List[String] = []
    var errors = 0
    for step in 0..ops:
        val k = f"k{rng.next(300)}"
        val i = keys.index_of(k) ?: -1
        if rng.next(3) == 0:
            if (m.remove(k) == null) != (i < 0):
                errors += 1
            if i >= 0:
                keys.remove_at(i)
        else:
            m[k] = m.get(k, 0) + step
            if i < 0:
                keys.push(k)
    var j = 0
    for k in m:
        if k != keys[j]:
            errors += 1
        j += 1
    return errors + (m.len() - keys.len())

fn check_structs(rng: Rng, ops: Int) -> Int:
    val m: Map[Key, Int] = {}
    val keys: List[Key] = []
    var errors = 0
    for step in 0..ops:
        val k = Key(rng.next(40), f"s{rng.next(5)}")
        val i = keys.index_of(k) ?: -1
        if rng.next(4) == 0:
            if (m.remove(k) == null) != (i < 0):
                errors += 1
            if i >= 0:
                keys.remove_at(i)
        else:
            m[k] = step
            if i < 0:
                keys.push(k)
        if m.contains(k) != (keys.index_of(k) != null):
            errors += 1
    var j = 0
    for k in m:
        if k != keys[j]:
            errors += 1
        j += 1
    return errors + (m.len() - keys.len())

fn main():
    val rng = Rng(42)
    print(check_ints(rng, 20_000, 50))
    print(check_ints(rng, 20_000, 2_000))
    print(check_strings(rng, 20_000))
    print(check_structs(rng, 10_000))

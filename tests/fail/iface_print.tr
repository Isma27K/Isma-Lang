# expect-error: add `fn to_string(self) -> String` to `interface Shape`
interface Shape:
    fn area(self) -> Float

interface Scalable(Shape):
    fn scale(self, by: Float)

struct Circle:
    r: Float

    fn area(self) -> Float:
        return 3.0 * self.r * self.r

struct Point:
    x: Int

fn main():
    val s: Shape = Circle(1.0)
    print(s)
    print(f"{s}")

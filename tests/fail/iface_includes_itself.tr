# expect-error: interface `A` includes itself
interface Shape:
    fn area(self) -> Float

interface Scalable(Shape):
    fn scale(self, by: Float)

struct Circle:
    r: Float

    fn area(self) -> Float:
        return 3.0 * self.r * self.r

struct Point:
    x: Int

interface A(B):
    fn a(self)

interface B(A):
    fn b(self)

fn main():
    pass

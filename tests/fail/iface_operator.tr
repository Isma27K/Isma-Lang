# expect-error: an interface can't ask for `fn +`
interface Shape:
    fn area(self) -> Float

interface Scalable(Shape):
    fn scale(self, by: Float)

struct Circle:
    r: Float

    fn area(self) -> Float:
        return 3.0 * self.r * self.r

struct Point:
    x: Int

interface Addable:
    fn +(self, other: Int) -> Int

fn main():
    pass

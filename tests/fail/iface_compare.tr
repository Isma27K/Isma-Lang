# expect-error: an interface value only has the interface's methods
interface Shape:
    fn area(self) -> Float

interface Scalable(Shape):
    fn scale(self, by: Float)

struct Circle:
    r: Float

    fn area(self) -> Float:
        return 3.0 * self.r * self.r

struct Point:
    x: Int

fn main():
    val a: Shape = Circle(1.0)
    val b: Shape = Circle(2.0)
    print(a == b)

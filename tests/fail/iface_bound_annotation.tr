# expect-error: `Gallery` needs `T` to be a `Shape`, but `Point` isn't
interface Shape:
    fn area(self) -> Float

interface Scalable(Shape):
    fn scale(self, by: Float)

struct Circle:
    r: Float

    fn area(self) -> Float:
        return 3.0 * self.r * self.r

struct Point:
    x: Int

struct Gallery[T: Shape]:
    items: List[T]

fn count(g: Gallery[Point]) -> Int:
    return g.items.len()

fn main():
    print(count(Gallery([Circle(1.0)])))

# expect-error: `Shape` is an interface: it has no values of its own
interface Shape:
    fn area(self) -> Float

interface Scalable(Shape):
    fn scale(self, by: Float)

struct Circle:
    r: Float

    fn area(self) -> Float:
        return 3.0 * self.r * self.r

struct Point:
    x: Int

fn main():
    val s = Shape()
    print(s.area())

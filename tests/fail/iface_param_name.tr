# expect-error: `Sq.scale` calls its parameter `k`, not `by`
interface Shape:
    fn area(self) -> Float

interface Scalable(Shape):
    fn scale(self, by: Float)

struct Circle:
    r: Float

    fn area(self) -> Float:
        return 3.0 * self.r * self.r

struct Point:
    x: Int

struct Sq:
    var side: Float
    fn area(self) -> Float:
        return self.side * self.side
    fn scale(self, k: Float):
        self.side *= k

fn main():
    val s: Scalable = Sq(2.0)
    s.scale(by=2.0)

# expect-error: this case can never match: `Dog` isn't a `Shape`
interface Shape:
    fn area(self) -> Float

struct Circle:
    r: Float

    fn area(self) -> Float:
        return self.r

struct Dog:
    name: String

fn kind(s: Shape) -> Int:
    match s:
        case Dog:
            return 2
        case Circle(r):
            return 1
        case _:
            return 0

fn main():
    print(kind(Circle(1.0)))

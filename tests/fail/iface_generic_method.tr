# expect-error: interface method `apply` can't have type parameters yet
interface Shape:
    fn area(self) -> Float

interface Scalable(Shape):
    fn scale(self, by: Float)

struct Circle:
    r: Float

    fn area(self) -> Float:
        return 3.0 * self.r * self.r

struct Point:
    x: Int

interface Mapper:
    fn apply[T](self, x: T) -> T

fn main():
    pass

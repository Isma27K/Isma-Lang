# expect-error: this might be `null`
interface Shape:
    fn area(self) -> Float

interface Scalable(Shape):
    fn scale(self, by: Float)

struct Circle:
    r: Float

    fn area(self) -> Float:
        return 3.0 * self.r * self.r

struct Point:
    x: Int

fn find(yes: Bool) -> Circle?:
    if yes:
        return Circle(1.0)
    return null

fn main():
    val s: Shape = find(true)
    print(s.area())

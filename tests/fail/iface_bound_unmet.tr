# expect-error: `total` needs `T` to be a `Shape`, but `Int` isn't
interface Shape:
    fn area(self) -> Float

interface Scalable(Shape):
    fn scale(self, by: Float)

struct Circle:
    r: Float

    fn area(self) -> Float:
        return 3.0 * self.r * self.r

struct Point:
    x: Int

fn total[T: Shape](xs: List[T]) -> Float:
    var sum = 0.0
    for x in xs:
        sum += x.area()
    return sum

fn main():
    print(total([1, 2]))

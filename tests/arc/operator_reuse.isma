# expect-max-allocs: 10
# Operator functions are ordinary methods to the memory passes: `acc = acc + v`
# and `acc += v` reuse `acc`'s memory just like `acc = acc.add(v)`.
struct Vec2:
    var x: Float
    var y: Float

    fn +(self, other: Vec2) -> Vec2:
        return Vec2(self.x + other.x, self.y + other.y)

fn main():
    var acc = Vec2(0.0, 0.0)
    val v = Vec2(1.0, 2.0)
    for _ in 0..500_000:
        acc = acc + v
    for _ in 0..500_000:
        acc += v
    print(acc.y)

# expect-max-allocs: 6
# Counting into a map allocates the map once: its entries and index are
# plain buffers, and Int keys and values are stored inline.
fn main():
    val counts: Map[Int, Int] = {}
    for i in 0..100_000:
        val k = i % 1000
        counts[k] = counts.get(k, 0) + 1
    var total = 0
    for k, v in counts:
        total += k * v
    print(total)

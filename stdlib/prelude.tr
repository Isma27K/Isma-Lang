# Always available, in every file, without an import: `Result` with `Ok` and
# `Err`, `Unit`, the structs behind tuples (`(A, B)` is a `Tuple2[A, B]`),
# the `Iterator` interface with the iterators its methods give, and `Field`
# and `Parameter`, what compile-time reflection describes.

# The outcome of something that can fail: its value (`Ok`) or what went wrong (`Err`).
#
#     fn parse_port(text: String) -> Result[Int, String]:
#         val n = text.to_int_or_null() ?: return Err(f"not a number: {text}")
#         if n < 1 or n > 65535:
#             return Err(f"out of range: {n}")
#         return Ok(n)
#
# Take one apart with `match` (`case Ok(port):` / `case Err(why):`), pass the
# error on to your caller with `?`, or use the methods below.
enum Result[T, E]:
    # It worked: here's the value.
    Ok(value: T)
    # It failed: here's why.
    Err(error: E)

    # Is it an `Ok`?
    fn is_ok(self) -> Bool:
        match self:
            case Ok(_):
                return true
            case Err(_):
                return false

    # Is it an `Err`?
    fn is_err(self) -> Bool:
        match self:
            case Ok(_):
                return false
            case Err(_):
                return true

    # The value, or `null` if it's an `Err`.
    fn value_or_null(self) -> T?:
        match self:
            case Ok(value):
                return value
            case Err(_):
                return null

    # The error, or `null` if it's an `Ok`.
    fn error_or_null(self) -> E?:
        match self:
            case Ok(_):
                return null
            case Err(error):
                return error

    # The value, or `default` if it's an `Err`.
    fn value_or(self, default: T) -> T:
        match self:
            case Ok(value):
                return value
            case Err(_):
                return default

    # The value changed by `f`, if it's an `Ok`; an `Err` stays as it is.
    fn map[U](self, f: fn(T) -> U) -> Result[U, E]:
        match self:
            case Ok(value):
                return Ok(f(value))
            case Err(error):
                return Err(error)

    # The error changed by `f`, if it's an `Err`; an `Ok` stays as it is.
    # Handy before `?` when your function fails with another error type.
    fn map_err[F](self, f: fn(E) -> F) -> Result[T, F]:
        match self:
            case Ok(value):
                return Ok(value)
            case Err(error):
                return Err(f(error))

    # `Ok(42)` or `Err(not a number)`.
    fn to_string(self) -> String:
        match self:
            case Ok(value):
                return f"Ok({value})"
            case Err(error):
                return f"Err({error})"

# "No value": the type to put in `Result[Unit, E]` for something that can fail
# but has nothing to give back. `Ok()` builds the successful one.
#
#     fn save(path: String, text: String) -> Result[Unit, String]:
#         if text.is_empty():
#             return Err("nothing to save")
#         fs.write(path, text)
#         return Ok()
enum Unit:
    Unit

# Tuples: `(Int, String)` is a `Tuple2[Int, String]`, written `(1, "a")` and
# read with `t.0`, `t.1`. The compiler names them by their elements, and
# `==`, `<=>`, `hash` and printing go element by element.
struct Tuple2[A, B]:
    _0: A
    _1: B

    fn ==(self, other: Tuple2[A, B]) -> Bool:
        return self._0 == other._0 and self._1 == other._1

    fn <=>(self, other: Tuple2[A, B]) -> Int:
        val c0 = self._0 <=> other._0
        if c0 != 0:
            return c0
        return self._1 <=> other._1

    fn hash(self) -> Int:
        return hash(self._0, self._1)

    fn to_string(self) -> String:
        return f"({__repr(self._0)}, {__repr(self._1)})"

struct Tuple3[A, B, C]:
    _0: A
    _1: B
    _2: C

    fn ==(self, other: Tuple3[A, B, C]) -> Bool:
        return self._0 == other._0 and self._1 == other._1 and self._2 == other._2

    fn <=>(self, other: Tuple3[A, B, C]) -> Int:
        val c0 = self._0 <=> other._0
        if c0 != 0:
            return c0
        val c1 = self._1 <=> other._1
        if c1 != 0:
            return c1
        return self._2 <=> other._2

    fn hash(self) -> Int:
        return hash(self._0, self._1, self._2)

    fn to_string(self) -> String:
        return f"({__repr(self._0)}, {__repr(self._1)}, {__repr(self._2)})"

struct Tuple4[A, B, C, D]:
    _0: A
    _1: B
    _2: C
    _3: D

    fn ==(self, other: Tuple4[A, B, C, D]) -> Bool:
        return self._0 == other._0 and self._1 == other._1 and self._2 == other._2 and self._3 == other._3

    fn <=>(self, other: Tuple4[A, B, C, D]) -> Int:
        val c0 = self._0 <=> other._0
        if c0 != 0:
            return c0
        val c1 = self._1 <=> other._1
        if c1 != 0:
            return c1
        val c2 = self._2 <=> other._2
        if c2 != 0:
            return c2
        return self._3 <=> other._3

    fn hash(self) -> Int:
        return hash(self._0, self._1, self._2, self._3)

    fn to_string(self) -> String:
        return f"({__repr(self._0)}, {__repr(self._1)}, {__repr(self._2)}, {__repr(self._3)})"

struct Tuple5[A, B, C, D, E]:
    _0: A
    _1: B
    _2: C
    _3: D
    _4: E

    fn ==(self, other: Tuple5[A, B, C, D, E]) -> Bool:
        return self._0 == other._0 and self._1 == other._1 and self._2 == other._2 and self._3 == other._3 and self._4 == other._4

    fn <=>(self, other: Tuple5[A, B, C, D, E]) -> Int:
        val c0 = self._0 <=> other._0
        if c0 != 0:
            return c0
        val c1 = self._1 <=> other._1
        if c1 != 0:
            return c1
        val c2 = self._2 <=> other._2
        if c2 != 0:
            return c2
        val c3 = self._3 <=> other._3
        if c3 != 0:
            return c3
        return self._4 <=> other._4

    fn hash(self) -> Int:
        return hash(self._0, self._1, self._2, self._3, self._4)

    fn to_string(self) -> String:
        return f"({__repr(self._0)}, {__repr(self._1)}, {__repr(self._2)}, {__repr(self._3)}, {__repr(self._4)})"

struct Tuple6[A, B, C, D, E, F]:
    _0: A
    _1: B
    _2: C
    _3: D
    _4: E
    _5: F

    fn ==(self, other: Tuple6[A, B, C, D, E, F]) -> Bool:
        return self._0 == other._0 and self._1 == other._1 and self._2 == other._2 and self._3 == other._3 and self._4 == other._4 and self._5 == other._5

    fn <=>(self, other: Tuple6[A, B, C, D, E, F]) -> Int:
        val c0 = self._0 <=> other._0
        if c0 != 0:
            return c0
        val c1 = self._1 <=> other._1
        if c1 != 0:
            return c1
        val c2 = self._2 <=> other._2
        if c2 != 0:
            return c2
        val c3 = self._3 <=> other._3
        if c3 != 0:
            return c3
        val c4 = self._4 <=> other._4
        if c4 != 0:
            return c4
        return self._5 <=> other._5

    fn hash(self) -> Int:
        return hash(self._0, self._1, self._2, self._3, self._4, self._5)

    fn to_string(self) -> String:
        return f"({__repr(self._0)}, {__repr(self._1)}, {__repr(self._2)}, {__repr(self._3)}, {__repr(self._4)}, {__repr(self._5)})"
# Something that gives values one at a time. `for x in it` calls `next()`
# until it returns `null`, so any type with a `next` like this one can be
# looped over. Saying `struct Lines(Iterator[String]):` also gives it the
# methods below (`map`, `filter`, `to_list`...), unless it has its own.
#
#     struct Countdown(Iterator[Int]):
#         var left: Int
#
#         fn next(self) -> Int?:
#             if self.left == 0:
#                 return null
#             self.left -= 1
#             return self.left + 1
#
#     for n in Countdown(3):
#         print(n)                          # 3, 2, 1
#     print(Countdown(5).filter(fn(n) -> n % 2 == 1).to_list())   # [5, 3, 1]
interface Iterator[T]:
    # The next value, or `null` when there are no more.
    fn next(self) -> T?

    # The values, changed by `f`: a new iterator, computed as it's read.
    fn map[U](self, f: fn(T) -> U) -> Mapped[T, U, Self]:
        return Mapped(self, f)

    # The values for which `keep` is true: a new iterator, computed as it's read.
    fn filter(self, keep: fn(T) -> Bool) -> Filtered[T, Self]:
        return Filtered(self, keep)

    # At most the first `n` values.
    fn take(self, n: Int) -> Taken[T, Self]:
        return Taken(self, n)

    # Each value with its position: `(0, a)`, `(1, b)`...
    fn enumerate(self) -> Enumerated[T, Self]:
        return Enumerated(self, 0)

    # Every value left, in a list.
    fn to_list(self) -> List[T]:
        val out: List[T] = []
        for x in self:
            out.push(x)
        return out

    # How many values are left (reading them all).
    fn count(self) -> Int:
        var n = 0
        for _ in self:
            n += 1
        return n

    # Combine the values into one, starting from `initial`: `f(acc, x)` gives the next `acc`.
    fn fold[A](self, initial: A, f: fn(A, T) -> A) -> A:
        var acc = initial
        for x in self:
            acc = f(acc, x)
        return acc

    # Is `f` true for some value? Stops at the first one.
    fn any(self, f: fn(T) -> Bool) -> Bool:
        for x in self:
            if f(x):
                return true
        return false

    # Is `f` true for every value? Stops at the first that fails.
    fn all(self, f: fn(T) -> Bool) -> Bool:
        for x in self:
            if not f(x):
                return false
        return true

    # The first value for which `f` is true, or `null`.
    fn find(self, f: fn(T) -> Bool) -> T?:
        for x in self:
            if f(x):
                return x
        return null

# What `it.map(f)` gives.
struct Mapped[T, U, I: Iterator[T]](Iterator[U]):
    _source: I
    _f: fn(T) -> U

    fn next(self) -> U?:
        val x = self._source.next() ?: return null
        return self._f(x)

# What `it.filter(keep)` gives.
struct Filtered[T, I: Iterator[T]](Iterator[T]):
    _source: I
    _keep: fn(T) -> Bool

    fn next(self) -> T?:
        while true:
            val x = self._source.next() ?: return null
            if self._keep(x):
                return x
        return null

# What `it.take(n)` gives.
struct Taken[T, I: Iterator[T]](Iterator[T]):
    _source: I
    var _left: Int

    fn next(self) -> T?:
        if self._left <= 0:
            return null
        self._left -= 1
        return self._source.next()

# What `it.enumerate()` gives.
struct Enumerated[T, I: Iterator[T]](Iterator[(Int, T)]):
    _source: I
    var _at: Int

    fn next(self) -> (Int, T)?:
        val x = self._source.next() ?: return null
        self._at += 1
        return (self._at - 1, x)

# A task started with `spawn(fn() -> ...)`, running alongside the code that
# started it. `join()` waits for what it returns.
#
#     val t = spawn(fn() -> fetch(url))
#     match t.join():
#         case Ok(page): print(page.len())
#         case Err(p): print(f"the task failed: {p}")
struct Task[T]:
    _h: __Handle

    # Wait until the task is done: what it returned, or the panic that stopped it.
    # (Its result is given once: a second `join()` panics.)
    fn join(self) -> Result[T, Panic]:
        if __task_wait(self._h):
            return Ok(__task_take[T](self._h))
        return Err(Panic(__task_panic_message(self._h), __task_panic_location(self._h)))

    # Has it finished (returned or panicked)? Doesn't wait.
    fn is_done(self) -> Bool:
        return __task_is_done(self._h)

# Why a task stopped: the panic's message, and where it happened (`app.tr:12:9`).
struct Panic:
    message: String
    location: String

    # `index 9 out of bounds for list of length 3 (at app.tr:12:9)`
    fn to_string(self) -> String:
        return f"{self.message} (at {self.location})"

# Values sent from some tasks to others, in order. `send` waits while the
# channel is full (an unbuffered one: until the value is received), and
# `receive` waits while it's empty. Once it's closed and empty, `receive`
# gives `null` and a `for` loop over it ends.
#
#     val jobs: Channel[Int] = Channel.buffered(100)
#     val worker = spawn(fn() -> jobs.map(fn(n) -> n * n).fold(0, fn(a, n) -> a + n))
#     for n in 1..=10:
#         jobs.send(n)
#     jobs.close()
#     print(worker.join()!!)                # 385
struct Channel[T](Iterator[T]):
    _h: __Handle

    # An unbuffered channel: each `send` waits until a `receive` takes its value.
    fn new() -> Channel[T]:
        return Channel(__chan_new[T](0))

    # A channel that holds up to `capacity` values before `send` waits.
    fn buffered(capacity: Int) -> Channel[T]:
        return Channel(__chan_new[T](capacity))

    # Put a value in (moved to whoever receives it, or copied if this task
    # still uses it). Panics if the channel is closed.
    fn send(self, value: T):
        __chan_send(self._h, value)

    # The next value, or `null` once the channel is closed and empty.
    fn receive(self) -> T?:
        return __chan_receive[T](self._h)

    # The same as `receive`: a `for` loop over a channel takes values until it's closed.
    fn next(self) -> T?:
        return __chan_receive[T](self._h)

    # No more values will be sent: receivers get what's left, then `null`.
    fn close(self):
        __chan_close(self._h)

    fn is_closed(self) -> Bool:
        return __chan_is_closed(self._h)

    # How many values are waiting to be received.
    fn len(self) -> Int:
        return __chan_len(self._h)

# A value that several tasks share, changed by one at a time. A task holds
# it while a function runs on it: what goes in is moved (or copied) in,
# what comes out is moved (or copied) out, so no task keeps a hold on it.
#
#     val hits: Mutex[Map[String, Int]] = Mutex({})
#     hits.lock(fn(m) -> m["home"] = m.get("home", 0) + 1)
#     print(hits.lock(fn(m) -> m.len()))
struct Mutex[T]:
    _h: __Handle

    fn new(value: T) -> Mutex[T]:
        return Mutex(__mutex_new(value))

    # Run `f` on the value while holding it (other tasks wait), and give what `f` returns.
    fn lock[R](self, f: fn(T) -> R) -> R:
        return __mutex_lock(self._h, f)

    # Replace the value with what `f` makes of it, while holding it.
    fn update(self, f: fn(T) -> T):
        __mutex_update(self._h, f)

    # A copy of the value.
    fn get(self) -> T:
        return __mutex_get[T](self._h)

    # Replace the value.
    fn set(self, value: T):
        __mutex_set(self._h, value)

# An `Int` that several tasks can read and change at once, without a lock.
#
#     val done = Atomic(0)
#     for i in 0..8:
#         spawn(fn() -> done.add(1))
struct Atomic:
    _h: __Handle

    fn new(value: Int) -> Atomic:
        return Atomic(__atomic_new(value))

    fn get(self) -> Int:
        return __atomic_get(self._h)

    fn set(self, value: Int):
        __atomic_set(self._h, value)

    # Add `n` (which may be negative), and give the new value.
    fn add(self, n: Int) -> Int:
        return __atomic_add(self._h, n)

    # Put `value` in, and give the one it replaced.
    fn swap(self, value: Int) -> Int:
        return __atomic_swap(self._h, value)

    # If the value is `expected`, replace it with `value`: did it?
    fn compare_and_set(self, expected: Int, value: Int) -> Bool:
        return __atomic_compare_and_set(self._h, expected, value)

# A field of a struct, as `fields(T)` gives it. Code that runs while
# compiling loops over them with `comptime for`:
#
#     fn show[T](value: T) -> String:
#         var parts: List[String] = []
#         comptime for f in fields(T):
#             parts.append(f"{f.name}={f.get(value)}")
#         return parts.join(" ")
#
# Inside a `comptime for`, the compiler knows which field `f` is, so
# `f.get(value)` reads it from a `T` (with its own type), `f.attribute(a)` is
# its `@a(...)` attribute (or `null`) and `f.has(a)` says if it has one.
struct Field:
    # Its name, as written in the struct (`"0"`, `"1"`... in a tuple).
    name: String
    # Its type, as Tarn writes it: `Int`, `List[String]`, `User?`.
    type_name: String
    # Is it declared with `var`?
    mutable: Bool
    # Does it have a default value (`port: Int = 8080`)?
    has_default: Bool

# A parameter of a function, as `params(H)` gives it (for a function passed
# as `[H: Function]`). `p.attribute(a)` and `p.has(a)` read its attributes.
struct Parameter:
    # Its name, as written.
    name: String
    # Its type, as Tarn writes it.
    type_name: String

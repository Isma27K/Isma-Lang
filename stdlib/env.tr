# Environment variables: settings a program gets from whoever started it,
# and from a `.env` file.
#
#     import env
#
#     val port = env.get("PORT")?.to_int_or_null() ?: 8080
#     val mode = env.get_or("APP_MODE", "development")
#     val debug = env.get_bool_or("DEBUG", false)
#     env.set("APP_MODE", "test")     # for this program, and programs it starts
#
# The first time a program uses `env`, it reads the `.env` file in the folder
# of its main file (`tarn app.tr` reads the `.env` next to `app.tr`), if
# there is one. A built program that has been moved elsewhere reads the
# `.env` in the current folder instead.
#
#     # .env
#     PORT=8080
#     DATABASE_URL="postgres://localhost/app"     # quotes are optional
#     export GREETING='hello, world'
#     LOG_FILE=${HOME}/app.log
#
# A variable that is already set when the program starts wins over the file.
# To read another file instead, call `env.load(path)` before using `env`.

# Read the variables of the `.env` file at `path` (relative to the current
# folder), for those that aren't set yet. Called before anything else in
# `env`, it replaces the default `.env`. An `Err` says why the file couldn't
# be read, or which line is malformed.
fn load(path: String) -> Result[Unit, String]:
    val _ = __env_claim_default()
    val text = __fs_read(path) ?: return Err(__fs_last_error())
    _apply(_parse(text, path)?)
    return Ok()

# The value of variable `name`, or `null` if it isn't set.
fn get(name: String) -> String?:
    _ensure()
    return __env_get(name)

# The value of variable `name`, or `default` if it isn't set.
fn get_or(name: String, default: String) -> String:
    _ensure()
    return __env_get(name) ?: default

# Variable `name` as a `Bool`: `true`, `yes`, `on` and `1` are true, `false`,
# `no`, `off` and `0` are false, in any case. `null` if it isn't set or is
# empty. Panics if it's set to something else (`DEBUG=maybe`).
fn get_bool(name: String) -> Bool?:
    _ensure()
    val text = __env_get(name) ?: return null
    if text.trim().is_empty():
        return null
    return text.to_bool_or_null() ?: panic(f"environment variable {name}={text} isn't a boolean: use true or false (or yes/no, on/off, 1/0)")

# Variable `name` as a `Bool` (see `get_bool`), or `default` if it isn't set or is empty.
fn get_bool_or(name: String, default: Bool) -> Bool:
    return get_bool(name) ?: default

# Set variable `name` to `value`. Panics if `name` is empty or contains `=`.
fn set(name: String, value: String):
    _ensure()
    if not __env_set(name, value):
        panic(f"env.set(): `{name}` can't be a variable name (it must be non-empty, without `=`), or the value contains a NUL byte")

# Unset variable `name` (nothing happens if it isn't set).
fn remove(name: String):
    _ensure()
    if not __env_remove(name):
        panic(f"env.remove(): `{name}` can't be a variable name (it must be non-empty, without `=`)")

# Every variable, by name.
fn all() -> Map[String, String]:
    _ensure()
    val out: Map[String, String] = {}
    for entry in __env_all():
        val eq = entry.find("=") ?: continue
        out[entry.substring(0, eq)] = entry.substring(eq + 1, entry.len())
    return out

# The default `.env`, read the first time `env` is used.
fn _ensure():
    if not __env_claim_default():
        return
    val root = __env_root_dir()
    var dir = __fs_cwd()
    if not root.is_empty() and __fs_kind(root) == 2:
        dir = root
    val path = f"{dir}/.env"
    if __fs_kind(path) != 1:
        return
    val text = __fs_read(path) ?: panic(__fs_last_error())
    match _parse(text, path):
        case Ok(vars):
            _apply(vars)
        case Err(why):
            panic(why)

# Set the variables that aren't set yet.
fn _apply(vars: Map[String, String]):
    for name, value in vars:
        if __env_get(name) == null:
            val _ = __env_set(name, value)

# The variables in `.env` text, in order, or an error naming the line.
fn _parse(text: String, path: String) -> Result[Map[String, String], String]:
    val vars: Map[String, String] = {}
    val cs = text.chars()
    val n = cs.len()
    var i = 0
    var line = 1
    while i < n:
        val c = cs[i]
        if c == "\n":
            line += 1
            i += 1
        elif c == " " or c == "\t" or c == "\r":
            i += 1
        elif c == "#":
            i = _end_of_line(cs, i)
        else:
            # NAME=value, maybe after `export `.
            var name = _name(cs, i)
            i += name.len()
            if name == "export" and i < n and (cs[i] == " " or cs[i] == "\t"):
                i = _skip_blanks(cs, i)
                name = _name(cs, i)
                i += name.len()
            if name.is_empty():
                return Err(f"{path}:{line}: expected a variable name, found {_shown(cs, i)}")
            i = _skip_blanks(cs, i)
            if i >= n or cs[i] != "=":
                return Err(f"{path}:{line}: expected `=` after `{name}`, found {_shown(cs, i)}")
            i = _skip_blanks(cs, i + 1)
            var value = ""
            if i < n and (cs[i] == "\"" or cs[i] == "'"):
                # Quoted: may span lines. Double quotes take escapes and `${NAME}`.
                val quote = cs[i]
                val first_line = line
                i += 1
                var closed = false
                while i < n and not closed:
                    val d = cs[i]
                    if d == quote:
                        closed = true
                    elif d == "\\" and quote == "\"" and i + 1 < n:
                        i += 1
                        value += _escape(cs[i])
                    elif d == "$" and quote == "\"" and i + 1 < n and cs[i + 1] == "{":
                        val piece = _expand(cs, i, vars, path, line)?
                        value += piece.text
                        i = piece.end
                    else:
                        if d == "\n":
                            line += 1
                        value += d
                    i += 1
                if not closed:
                    return Err(f"{path}:{first_line}: the value of `{name}` has no closing {quote}")
                i = _skip_blanks(cs, i)
                if i < n and cs[i] == "#":
                    i = _end_of_line(cs, i)
                elif i < n and cs[i] != "\n" and cs[i] != "\r":
                    return Err(f"{path}:{line}: unexpected {_shown(cs, i)} after the closing {quote}")
            else:
                # Unquoted: to the end of the line, or to a ` #` comment.
                while i < n and cs[i] != "\n":
                    val d = cs[i]
                    if d == "#" and (value.is_empty() or value.ends_with(" ") or value.ends_with("\t")):
                        i = _end_of_line(cs, i) - 1
                    elif d == "$" and i + 1 < n and cs[i + 1] == "{":
                        val piece = _expand(cs, i, vars, path, line)?
                        value += piece.text
                        i = piece.end
                    else:
                        value += d
                    i += 1
                value = value.trim_end()
            vars[name] = value
    return Ok(vars)

# `${NAME}` at `i`: the variable's value (already set, or from earlier in the
# file, or "") and where the `}` is.
struct _Piece:
    text: String
    end: Int

fn _expand(cs: List[String], i: Int, vars: Map[String, String], path: String, line: Int) -> Result[_Piece, String]:
    var j = i + 2
    var name = ""
    while j < cs.len() and cs[j] != "}" and cs[j] != "\n":
        name += cs[j]
        j += 1
    if j >= cs.len() or cs[j] != "}":
        return Err(f"{path}:{line}: `${{` without a closing `}}`")
    return Ok(_Piece(__env_get(name) ?: vars.get(name) ?: "", j))

fn _name(cs: List[String], start: Int) -> String:
    var name = ""
    var i = start
    while i < cs.len():
        val c = cs[i]
        if not (c == "_" or (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9")):
            return name
        name += c
        i += 1
    return name

fn _skip_blanks(cs: List[String], start: Int) -> Int:
    var i = start
    while i < cs.len() and (cs[i] == " " or cs[i] == "\t"):
        i += 1
    return i

# The index of the `\n` ending the line (or the end of the text).
fn _end_of_line(cs: List[String], start: Int) -> Int:
    var i = start
    while i < cs.len() and cs[i] != "\n":
        i += 1
    return i

fn _escape(c: String) -> String:
    match c:
        case "n":
            return "\n"
        case "t":
            return "\t"
        case "r":
            return "\r"
        case "\"" | "\\" | "$":
            return c
        case _:
            return "\\" + c

fn _shown(cs: List[String], i: Int) -> String:
    if i >= cs.len() or cs[i] == "\n" or cs[i] == "\r":
        return "the end of the line"
    return f"`{cs[i]}`"

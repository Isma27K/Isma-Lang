struct Vec2:
    var x: Float
    var y: Float

    fn +(self, o: Vec2) -> Vec2:
        return Vec2(self.x + o.x, self.y + o.y)

fn main():
    var pos = Vec2(0.0, 0.0)
    var vel = Vec2(1.0, 0.5)
    val gravity = Vec2(0.0, -0.001)
    for _ in 0..5_000_000:
        vel += gravity
        pos = pos + vel
    print(pos.x.to_int())
    print(pos.y.to_int())

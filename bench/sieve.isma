fn main():
    val limit = 10_000_000
    var is_prime: List[Bool] = []
    for i in 0..=limit:
        is_prime.push(true)
    is_prime[0] = false
    is_prime[1] = false
    var i = 2
    while i * i <= limit:
        if is_prime[i]:
            var j = i * i
            while j <= limit:
                is_prime[j] = false
                j += i
        i += 1
    var count = 0
    for p in is_prime:
        if p:
            count += 1
    print(count)
